# Evolution API
EVOLUTION_API_KEY=sua-chave-segura-aqui
EVOLUTION_INSTANCE_NAME=jansen-banda
EVOLUTION_SERVER_URL=http://SEU_IP_PUBLICO:8081

# IA (Groq, compatível com OpenAI: https://console.groq.com)
GEMINI_API_KEY=sua-chave-groq-aqui

# Google Sheets
GOOGLE_SHEETS_ID=1abc...xyz
# Coloque google-credentials.json em ./credentials/

# Banda
BANDA_NOME=Nome da Banda
BANDA_ADMIN_PHONES=5511999999999,5511888888888

# Banco do bot (Postgres, serviço postgres-bot)
BOT_DB_URL=jdbc:postgresql://postgres-bot:5432/jansenbot
BOT_DB_DB=jansenbot
BOT_DB_USER=jansenbot
BOT_DB_PASSWORD=defina-uma-senha-aqui

# Banco da Evolution API (Postgres, serviço evolution-postgres)
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=defina-uma-senha-aqui
EVOLUTION_DB_DB=evolution
